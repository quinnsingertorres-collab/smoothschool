# Copy this file to .env.local (for local development) and fill in the
# values from your Firebase project settings. In Vercel, add the same
# six values under Project Settings -> Environment Variables instead.
#
# Firebase Console -> Project settings (gear icon) -> General ->
# "Your apps" -> the web app -> SDK setup and configuration -> Config

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
